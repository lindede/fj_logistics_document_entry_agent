# 与 kb_pdf_to_vdb 对齐：OpenAI 兼容网关（智谱 bigmodel）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 多模态：PDF/vision 解析（file_url）
OPENAI_MODEL=glm-4.6v
# 纯文本：Done 指令修正 / nl_patch（推荐 flash，勿用视觉模型）
OPENAI_TEXT_MODEL=glm-4.5-air
OPENAI_TEMPERATURE=0.1

# pdf=file_url 直传整份 PDF（默认）
# vision=每页渲成图片再传；text=纯文本（丢版面）
# html=文字坐标 HTML，走 OPENAI_TEXT_MODEL（不画 PDF 框线）
# html_struct=坐标和矩形框按标题抽取，不调用大模型（xtml_struct 同义）
# html_mix=先 struct 再 html LLM，主结果用 LLM，不一致字段 MIX-DIFF WARN
LLM_INPUT_MODE=pdf
LLM_PDF_FALLBACK_VISION=true
# vision 时 PDF→PNG 倍率（默认 1.5；传的是 PNG 不是 JPG）
LLM_VISION_ZOOM=1.5

PARSE_BACKEND=llm
SUBMIT_STRATEGY=manual
CONFIDENCE_THRESHOLD=0.55
DATA_DIR=data
# 解析调试：true 时每次 booking parse 写一份 JSON 到 DEBUG_DIR
PARSE_DEBUG_DUMP=false
# 指令轨迹：true 写 data/debug/amend_*.json；空则跟随 PARSE_DEBUG_DUMP
AMEND_DEBUG_DUMP=
DEBUG_DIR=data/debug

# all=单进程；tool=仅解析校验；agent=会话（须 TOOL_BASE_URL）
APP_ROLE=all
# 双进程时 Agent 指向 Tool，例如 http://127.0.0.1:8001
TOOL_BASE_URL=
TOOL_HTTP_TIMEOUT_S=120
