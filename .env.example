# 与 kb_pdf_to_vdb 对齐：OpenAI 兼容网关（智谱 bigmodel）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 多模态：支持 file_url 直接传 PDF
OPENAI_MODEL=glm-4.6v-flash
OPENAI_TEMPERATURE=0.1

# pdf=file_url 直传整份 PDF（推荐，多页一份文件）
# vision=每页渲成图片再传（回退）；text=纯文本（丢版面，不推荐）
LLM_INPUT_MODE=pdf
LLM_PDF_FALLBACK_VISION=true

PARSE_BACKEND=llm
SUBMIT_STRATEGY=manual
CONFIDENCE_THRESHOLD=0.55
DATA_DIR=data
