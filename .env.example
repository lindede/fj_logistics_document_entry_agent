# 复制为 .env 后填写密钥。勿把含真实 OPENAI_API_KEY 的 .env 提交进仓。
# 与 kb_pdf_to_vdb 对齐：OpenAI 兼容网关（智谱 bigmodel）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 多模态：PDF/vision 解析（file_url）
OPENAI_MODEL=glm-4.6v
# 文本模型：html / html_mix / text 抽取，以及 Done 指令修正 / nl_patch
# （勿把视觉模型填到这里）
OPENAI_TEXT_MODEL=glm-5.3
OPENAI_TEMPERATURE=0.1

# 演示默认 html_mix；亦支持：
# pdf=file_url 直传整份 PDF
# vision=每页渲成图片再传；text=纯文本（丢版面）
# html=文字坐标 HTML，走 OPENAI_TEXT_MODEL（不画框线给模型；需文字层）
# html_struct=版式分类 + 坐标/矩形规则，不调用大模型（xtml_struct 同义；未知版式报错）
# html_mix=先 classify+struct 再 html LLM；主结果用 LLM；不一致 MIX-DIFF；未知版式 MIX-FORM
# html / html_struct / html_mix 无文字层时不静默回退 pdf/vision
# （未设环境变量时，代码内兜底仍为 pdf）
LLM_INPUT_MODE=html_mix
LLM_PDF_FALLBACK_VISION=true
# vision 时 PDF→PNG 倍率（传的是 PNG 不是 JPG）
LLM_VISION_ZOOM=2.5

PARSE_BACKEND=llm
SUBMIT_STRATEGY=auto_on_pass
CONFIDENCE_THRESHOLD=0.55
DATA_DIR=data
# 解析调试：true 时每次 booking parse 写一份 JSON 到 DEBUG_DIR
PARSE_DEBUG_DUMP=true
# 指令轨迹：true 写 data/debug/amend_*.json；空则跟随 PARSE_DEBUG_DUMP
AMEND_DEBUG_DUMP=
DEBUG_DIR=data/debug

# all=单进程；tool=仅解析校验；agent=会话（须 TOOL_BASE_URL）
APP_ROLE=all
# 双进程时 Agent 指向 Tool，例如 http://127.0.0.1:8001
TOOL_BASE_URL=
# Agent→Tool HTTP 超时秒数；html_mix + 慢文本模型可加大
TOOL_HTTP_TIMEOUT_S=180
